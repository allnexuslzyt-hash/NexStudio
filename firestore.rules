rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.displayName is string &&
             data.displayName.size() <= 120;
    }

    // Project Validation
    function isValidProject(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.ownerId is string &&
             data.ownerId.size() <= 128 &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('isPublic' in data) || data.isPublic is bool);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == request.auth.uid;
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get: if resource.data.isPublic == true || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if resource.data.isPublic == true || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && isValidProject(incoming()) && incoming().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Settings Collection (Maintenance mode, announcements, global site config)
    match /settings/{settingId} {
      // All users (even unauthenticated) must be able to read settings so maintenance mode takes effect globally
      allow read: if true;
      // Only the SuperAdmin can modify global site settings
      allow write: if isSignedIn() && (
        request.auth.token.email == 'allnexuslzyt@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'allnexuslzyt@gmail.com')
      );
    }
  }
}
