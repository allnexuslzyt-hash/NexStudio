rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'allnexuslzyt@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'allnexuslzyt@gmail.com')
      );
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() <= 128 &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.displayName is string &&
             data.displayName.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000));
    }

    // Support Ticket Validation
    function isValidTicket(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.subject is string &&
             data.subject.size() > 0 &&
             data.subject.size() <= 200 &&
             data.contactEmail is string &&
             data.contactEmail.size() <= 256 &&
             data.priority is string &&
             data.status is string;
    }

    // Project Validation
    function isValidProject(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.ownerId is string &&
             data.ownerId.size() <= 128 &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('isPublic' in data) || data.isPublic is bool);
    }

    // Community Post Validation
    function isValidCommunityPost(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.authorId is string &&
             data.authorId.size() <= 128 &&
             data.authorName is string &&
             data.authorName.size() > 0 &&
             data.authorName.size() <= 120 &&
             data.content is string &&
             data.content.size() <= 4000 &&
             (!('attachmentUrl' in data) || data.attachmentUrl is string) &&
             (!('attachmentName' in data) || data.attachmentName is string) &&
             (!('attachmentType' in data) || data.attachmentType is string) &&
             (!('attachmentSize' in data) || data.attachmentSize is number) &&
             (!('visibility' in data) || data.visibility is string) &&
             (!('likes' in data) || (data.likes is list && data.likes.size() <= 1000)) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             (!('commentsCount' in data) || data.commentsCount is number) &&
             (!('sharesCount' in data) || data.sharesCount is number);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == request.auth.uid) || isAdmin();
      allow update: if (isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Support Tickets Collection (Solo usuarios registrados pueden abrir tickets)
    match /support_tickets/{ticketId} {
      allow get: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.contactEmail == request.auth.token.email));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.contactEmail == request.auth.token.email));
      allow create: if isSignedIn() && isValidId(ticketId) && isValidTicket(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.contactEmail == request.auth.token.email));
      allow delete: if isAdmin();
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get: if resource.data.isPublic == true || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if resource.data.isPublic == true || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && isValidProject(incoming()) && incoming().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Settings Collection (Maintenance mode, announcements, global site config)
    match /settings/{settingId} {
      // All users (even unauthenticated) must be able to read settings so maintenance mode takes effect globally
      allow read: if true;
      // Only the SuperAdmin can modify global site settings
      allow write: if isSignedIn() && (
        request.auth.token.email == 'allnexuslzyt@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'allnexuslzyt@gmail.com')
      );
    }

    // Community Social Feed Posts & Discussions
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && isValidCommunityPost(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.authorId == request.auth.uid && isValidCommunityPost(incoming()) && incoming().authorId == resource.data.authorId) ||
        (isValidCommunityPost(incoming()) && incoming().authorId == resource.data.authorId && incoming().content == resource.data.content)
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(commentId) && incoming().authorId == request.auth.uid && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 1000;
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid && incoming().authorId == resource.data.authorId && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 1000;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    // Top-level Post Comments Collection
    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commentId) && incoming().authorId == request.auth.uid && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 1000;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid && incoming().authorId == resource.data.authorId && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 1000;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }
  }
}
