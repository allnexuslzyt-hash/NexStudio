{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile document stored upon registration or login",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID of the user"
        },
        "email": {
          "type": "string",
          "description": "The email address of the authenticated user"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "URL of user avatar"
        },
        "role": {
          "type": "string",
          "description": "User role in NexStudio"
        },
        "username": {
          "type": "string",
          "description": "Unique alphanumeric username without symbols or numbers"
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Flag indicating if user completed initial username/profile onboarding"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp string or server timestamp"
        }
      },
      "required": ["userId", "email", "displayName"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer and community support ticket with real-time messages",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ticket ID"
        },
        "subject": {
          "type": "string",
          "description": "Ticket subject or reason"
        },
        "contactEmail": {
          "type": "string",
          "description": "Contact email of petitioner"
        },
        "priority": {
          "type": "string",
          "description": "Priority: baja, media, alta, urgente"
        },
        "status": {
          "type": "string",
          "description": "Status: abierto, en_proceso, cerrado"
        },
        "userId": {
          "type": "string",
          "description": "UID of creator if authenticated"
        },
        "userName": {
          "type": "string",
          "description": "Name of petitioner"
        },
        "claimedBy": {
          "type": "string",
          "description": "UID of admin claiming the ticket"
        },
        "claimedByName": {
          "type": "string",
          "description": "Display name of admin claiming ticket"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "subject", "contactEmail", "priority", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Creative projects, repositories or studio showcases",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the project"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner"
        },
        "title": {
          "type": "string",
          "description": "Title of the project or studio file"
        },
        "description": {
          "type": "string",
          "description": "Short summary or description"
        },
        "category": {
          "type": "string",
          "description": "Category: web, 3d, mobile, motion, design"
        },
        "thumbnail": {
          "type": "string",
          "description": "Cover image URL"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Public visibility flag"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "ownerId", "title"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global application configuration including maintenance mode and global announcements",
      "type": "object",
      "properties": {
        "maintenanceMode": {
          "type": "boolean",
          "description": "Global kill switch to close website for non-admin visitors"
        },
        "maintenanceMessage": {
          "type": "string",
          "description": "Message displayed on maintenance screen"
        },
        "maintenanceEstimatedReturn": {
          "type": "string",
          "description": "Estimated return time"
        },
        "allowNewRegistrations": {
          "type": "boolean",
          "description": "Whether new registrations are permitted"
        },
        "lastUpdated": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email of admin who updated the settings"
        },
        "banner": {
          "type": "object",
          "description": "Global top banner configuration"
        }
      },
      "required": ["maintenanceMode"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Public social post shared by authenticated users in the community feed",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique post ID"
        },
        "authorId": {
          "type": "string",
          "description": "Firebase Auth UID of the post creator"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of author"
        },
        "authorUsername": {
          "type": "string",
          "description": "Unique username of author"
        },
        "authorPhotoURL": {
          "type": "string",
          "description": "Avatar URL of author"
        },
        "authorRole": {
          "type": "string",
          "description": "Author role in the platform"
        },
        "content": {
          "type": "string",
          "description": "Post text content, reflections or project summary"
        },
        "projectId": {
          "type": "string",
          "description": "Attached project ID if sharing a project"
        },
        "projectTitle": {
          "type": "string",
          "description": "Title of attached project"
        },
        "projectCategory": {
          "type": "string",
          "description": "Category of attached project"
        },
        "projectTag": {
          "type": "string",
          "description": "Tag or badge of attached project"
        },
        "projectLink": {
          "type": "string",
          "description": "Download or external link for attached project"
        },
        "likes": {
          "type": "array",
          "description": "Array of user IDs who liked this post"
        },
        "likesCount": {
          "type": "number",
          "description": "Cached total likes count"
        },
        "commentsCount": {
          "type": "number",
          "description": "Cached total comments count"
        },
        "sharesCount": {
          "type": "number",
          "description": "Cached total shares count"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp string of post creation"
        }
      },
      "required": ["id", "authorId", "authorName", "content"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment reply on a community social post",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique comment ID"
        },
        "postId": {
          "type": "string",
          "description": "ID of parent post"
        },
        "authorId": {
          "type": "string",
          "description": "UID of comment author"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of comment author"
        },
        "authorUsername": {
          "type": "string",
          "description": "Username of comment author"
        },
        "authorPhotoURL": {
          "type": "string",
          "description": "Avatar of comment author"
        },
        "content": {
          "type": "string",
          "description": "Comment text content"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp string of creation"
        }
      },
      "required": ["id", "postId", "authorId", "authorName", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles accessed and managed by the owner"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Creative showcases and project files"
    },
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global site settings including maintenance mode and global banners"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets and real-time conversation between users and support staff"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Public social network feed posts where users share thoughts and projects"
    },
    "/community_posts/{postId}/comments/{commentId}": {
      "schema": "PostComment",
      "description": "Public comments and discussions under a community post"
    }
  }
}
